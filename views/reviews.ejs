<%
  const tstDate = (t) => formatDateID(t.display_date || t.created_at);
  const initials = (name) => String(name || '?').trim().charAt(0).toUpperCase();
%>
<section class="page-head page-head--breadcrumb">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="<%= base %>/">Home</a><span aria-hidden="true">/</span>
      <span><%= site['ulasan.title'] %></span>
    </nav>
    <span class="eyebrow">Client Stories</span>
    <h1><%= site['ulasan.title'] %></h1>
    <p class="page-head__lede"><%= site['ulasan.description'] %></p>
  </div>
</section>

<section class="section section--tight">
  <div class="container">
    <% if (!testimonials.length) { %>
      <div class="empty-state">
        <h2>Belum ada ulasan yang ditampilkan</h2>
        <p>Admin belum mengaktifkan ulasan klien. Ulasan asli akan tampil di sini setelah diaktifkan melalui dashboard.</p>
        <a class="btn btn--primary" href="<%= base %>/gallery">Lihat Gallery</a>
      </div>
    <% } else { %>
      <% if (testimonials.some(function (t) { return t.is_placeholder; })) { %>
        <p class="note-inline">Ulasan bertanda <span class="badge-sample badge-sample--inline">Contoh</span> adalah entri sementara dan belum merupakan ulasan asli klien.</p>
      <% } %>
      <div class="testimonial-grid testimonial-grid--page">
        <% testimonials.forEach(function (t) { %>
          <figure class="testimonial">
            <div class="testimonial__head">
              <span class="testimonial__avatar">
                <% if (t.photo) { %>
                  <%- picture(t.photo, { alt: 'Foto ' + t.client_name, widths: [96, 192, 320], sizes: '72px' }) %>
                <% } else { %>
                  <span aria-hidden="true"><%= initials(t.client_name) %></span>
                <% } %>
              </span>
              <div class="testimonial__who">
                <span class="testimonial__name"><%= t.client_name %></span>
                <% if (t.campus || t.client_meta) { %>
                  <span class="testimonial__campus"><%= t.campus || t.client_meta %></span>
                <% } %>
              </div>
            </div>

            <div class="testimonial__rating">
              <%- include('partials/stars', { rating: t.rating }) %>
            </div>

            <blockquote><%= t.quote %></blockquote>

            <div class="testimonial__foot">
              <% if (t.is_placeholder) { %><span class="badge-sample badge-sample--inline">Contoh</span><% } %>
              <% if (tstDate(t)) { %><span class="testimonial__date"><%= tstDate(t) %></span><% } %>
            </div>
          </figure>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>

<section class="cta-band cta-band--compact">
  <div class="container cta-band__inner">
    <div>
      <h2>Ingin merasakan sesinya sendiri?</h2>
      <p>Pilih sesi dan tanggal, lalu kirim permintaan booking Anda.</p>
    </div>
    <div class="cta-band__actions">
      <a class="btn btn--light" href="<%= base %>/booking">Book Your Session</a>
      <a class="btn btn--outline-light" href="<%= base %>/pricelist">Lihat Pricelist</a>
    </div>
  </div>
</section>
