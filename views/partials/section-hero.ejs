<%
  const posClass = { center: '50% 50%', top: '50% 22%', bottom: '50% 78%', left: '28% 50%', right: '72% 50%' };
  const autoplay = site['hero.autoplay'] === '1';
  const interval = Number(site['hero.interval_ms']) || 6000;
  const transition = Number(site['hero.transition_ms']) || 1300;
  const overlayOpacity = Math.min(90, Math.max(0, Number(site['hero.overlay_opacity']))) / 100;
  const showControls = site['hero.show_controls'] === '1';
%>
<section class="hero<%= site['hero.kenburns'] === '1' ? ' hero--kenburns' : '' %>"
         data-hero
         data-autoplay="<%= autoplay ? '1' : '0' %>"
         data-interval="<%= interval %>"
         data-transition="<%= transition %>"
         style="--hero-overlay: <%= site['hero.overlay_color'] || '#0B2340' %>; --hero-overlay-opacity: <%= overlayOpacity %>; --hero-transition: <%= transition %>ms;"
         aria-roledescription="carousel"
         aria-label="Foto wisuda DLY Graduation">

  <div class="hero__slides" data-hero-slides>
    <% if (!heroSlides.length) { %>
      <div class="hero__slide is-active"><div class="hero__fallback"></div></div>
    <% } %>
    <% heroSlides.forEach(function (slide, i) { %>
      <figure class="hero__slide <%= i === 0 ? 'is-active' : '' %>" data-slide
              style="--pos-d: <%= posClass[slide.desktop_position] || posClass.center %>; --pos-m: <%= posClass[slide.mobile_position] || posClass.center %>;"
              aria-hidden="<%= i === 0 ? 'false' : 'true' %>">
        <%# V10: only slide 1 ships an <img src>. All slides sit in the same viewport box,
            so `loading="lazy"` never deferred them — every visit downloaded the whole
            slideshow (4 × ~120KB). Slides 2..n expose their markup as data-* and app.js
            fills it in when they are about to appear. %>
        <% if (i === 0) { %>
          <%- picture(slide.image_url, {
                alt: slide.alt_text || slide.title || 'Foto wisuda 1',
                className: 'hero__img',
                widths: [480, 800, 1200, 1600, 2000],
                sizes: '100vw',
                priority: true
              }) %>
        <% } else { %>
          <template data-hero-defer><%- picture(slide.image_url, {
              alt: slide.alt_text || slide.title || ('Foto wisuda ' + (i + 1)),
              className: 'hero__img',
              widths: [480, 800, 1200, 1600, 2000],
              sizes: '100vw',
              eager: true
            }) %></template>
        <% } %>
      </figure>
    <% }); %>
  </div>

  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="hero__label"><%= site['hero.label'] %></span>
      <h1 class="hero__title">
        <%= site['hero.headline'] %><br>
        <em><%= site['hero.headline_accent'] %></em>
      </h1>
      <p class="hero__lede"><%= site['hero.description'] %></p>
      <div class="hero__actions">
        <%# Revisi: tombol portofolio memakai biru DLY + teks putih (bukan putih transparan) %>
        <a class="btn btn--hero-primary" href="<%= base %><%= site['hero.cta_primary_link'] || '/portfolio' %>"><%= site['hero.cta_primary'] %></a>
        <a class="btn btn--outline-light" href="<%= base %><%= site['hero.cta_secondary_link'] || '/booking' %>"><%= site['hero.cta_secondary'] %></a>
      </div>
      <ul class="hero__meta">
        <% ['hero.meta_1', 'hero.meta_2', 'hero.meta_3'].forEach(function (k) { if (site[k]) { %>
          <li><%= site[k] %></li>
        <% } }); %>
      </ul>
    </div>
  </div>

  <% if (heroSlides.length > 1 && showControls) { %>
    <div class="hero__controls">
      <div class="hero__pager" data-hero-dots role="tablist" aria-label="Pilih foto">
        <% heroSlides.forEach(function (slide, i) { %>
          <button type="button" class="hero__dot <%= i === 0 ? 'is-active' : '' %>" data-hero-dot="<%= i %>"
                  role="tab" aria-selected="<%= i === 0 ? 'true' : 'false' %>"
                  aria-label="Foto <%= i + 1 %>"></button>
        <% }); %>
      </div>
      <div class="hero__nav">
        <button type="button" class="hero__arrow" data-hero-prev aria-label="Foto sebelumnya">&#8249;</button>
        <span class="hero__counter"><span data-hero-current>01</span> / <%= String(heroSlides.length).padStart(2, '0') %></span>
        <button type="button" class="hero__arrow" data-hero-next aria-label="Foto berikutnya">&#8250;</button>
      </div>
      <% if (autoplay) { %>
        <button type="button" class="hero__pause" data-hero-toggle aria-label="Jeda slideshow" aria-pressed="false">
          <span data-hero-toggle-icon>❙❙</span>
        </button>
      <% } %>
    </div>
  <% } %>
</section>
