<div class="admin-panel">
  <div class="admin-panel__head">
    <div>
      <h2><%= mode === 'create' ? 'Tambah kategori' : 'Edit kategori' %></h2>
      <p class="admin-muted">Slug dipakai pada URL dan penyimpanan data, hindari mengubahnya setelah dipakai.</p>
    </div>
    <a class="admin-link" href="<%= base %>/admin/categories">&larr; Kembali</a>
  </div>

  <form method="post" action="<%= base %>/admin/categories/save" class="admin-form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <% if (category.id) { %><input type="hidden" name="id" value="<%= category.id %>"><% } %>

    <div class="admin-field-grid">
      <div class="admin-field">
        <label for="name">Nama kategori <span class="req">*</span></label>
        <input type="text" id="name" name="name" required value="<%= category.name %>" placeholder="Individual Package">
      </div>
      <div class="admin-field">
        <label for="slug">Slug</label>
        <input type="text" id="slug" name="slug" value="<%= category.slug %>" placeholder="individual">
      </div>
      <div class="admin-field admin-field--full">
        <label for="description">Deskripsi</label>
        <textarea id="description" name="description" rows="3"><%= category.description %></textarea>
      </div>
      <div class="admin-field">
        <label for="sort_order">Urutan</label>
        <input type="number" id="sort_order" name="sort_order" min="0" value="<%= category.sort_order %>">
      </div>
      <div class="admin-field">
        <label class="admin-check">
          <input type="checkbox" name="is_active" value="1" <%= category.is_active ? 'checked' : '' %>>
          <span>Tampilkan kategori ini</span>
        </label>
      </div>
    </div>

    <div class="admin-form__actions">
      <button class="admin-btn admin-btn--primary" type="submit">Simpan kategori</button>
      <a class="admin-btn" href="<%= base %>/admin/categories">Batal</a>
    </div>
  </form>
</div>
