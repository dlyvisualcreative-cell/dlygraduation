<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle || title %> — Admin <%= brand.name %></title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="<%= favicon.src %>" type="image/png">
  <link rel="alternate icon" href="<%= favicon.fallback %>" type="image/svg+xml">
  <link rel="apple-touch-icon" href="<%= favicon.src %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <%# v16 — seluruh Dashboard Admin memakai Montserrat (satu keluarga font, 400–700). %>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%= base %>/assets/admin.css?v=<%= assetVersion.admin %>">
</head>
<body class="admin-body" data-base="<%= base %>">
  <aside class="admin-side" data-side>
    <div class="admin-side__brand">
      <% if (brand.logos.onDark) { %>
        <img class="admin-side__logoimg" src="<%= brand.logos.onDark %>" alt="<%= brand.name %>" width="168" height="48">
      <% } else { %>
        <span class="admin-side__logo">DLY</span>
      <% } %>
      <div>
        <strong><%= brand.name %></strong>
        <small>Studio Manager</small>
      </div>
    </div>

    <%
      // Grouped + collapsible navigation (Tahap 3). `soon: true` marks a menu that is
      // deliberately not implemented yet — it is rendered as a disabled row, never as a
      // link that silently goes nowhere.
      const ICON = {
        overview: 'M4 13h6V4H4v9zm10 7h6v-9h-6v9zM4 20h6v-5H4v5zM14 9h6V4h-6v5z',
        content: 'M5 4h14v16H5zM8 8h8M8 12h8M8 16h5',
        palette: 'M12 3a9 9 0 1 0 0 18h2a2 2 0 0 0 0-4h-1a2 2 0 0 1 0-4h4a2 2 0 0 0 2-2 8 8 0 0 0-7-8z',
        type: 'M4 6h16M9 6v13M15 6v6',
        layers: 'M12 3l9 5-9 5-9-5 9-5zM3 13l9 5 9-5',
        image: 'M3 5h18v14H3zM3 16l5-5 4 4 3-3 6 6',
        plus: 'M12 5v14M5 12h14',
        doc: 'M6 3h8l4 4v14H6zM14 3v4h4',
        pin: 'M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11z',
        tag: 'M20 13l-7 7-9-9V4h7z',
        box: 'M3 7l9-4 9 4-9 4-9-4zm0 0v10l9 4 9-4V7',
        clock: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7v5l4 2',
        calendar: 'M4 6h16v14H4zM8 3v4M16 3v4M4 11h16',
        users: 'M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM2 20c0-3 3-5 6-5s6 2 6 5M14 20c0-3 3-5 6-5',
        help: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.8.4-1 .9-1 1.7M12 17h.01',
        star: 'M12 4l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8L3.5 10.2l5.9-.9z',
        link: 'M10 13a5 5 0 0 0 7 0l2-2a5 5 0 0 0-7-7l-1 1M14 11a5 5 0 0 0-7 0l-2 2a5 5 0 0 0 7 7l1-1',
        wallet: 'M3 7h18v12H3zM3 11h18M16 15h2',
        gear: 'M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM19 12l2-1-2-3-2 1-2-1-1-3h-4l-1 3-2 1-2-1-2 3 2 1v2l-2 1 2 3 2-1 2 1 1 3h4l1-3 2-1 2 1 2-3-2-1z',
        google: 'M12 11v2.5h4.2c-.2 1.3-1.5 3.8-4.2 3.8a4.3 4.3 0 1 1 0-8.6c1.4 0 2.3.6 2.8 1.1l1.9-1.8A7 7 0 1 0 12 19c4 0 6.7-2.8 6.7-6.8 0-.5-.1-.8-.1-1.2H12z',
        drive: 'M9 3l6 0 6 10.5-3 5.5H6L3 13.5zM9 3L3 13.5M15 3l6 10.5',
        home: 'M3 11l9-8 9 8M6 10v10h12V10',
        select: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM8.3 12.4l2.6 2.6 4.8-5.1',
        bell: 'M12 4a6 6 0 0 0-6 6v4l-2 3h16l-2-3v-4a6 6 0 0 0-6-6zM10 20a2 2 0 0 0 4 0',
        phone: 'M7 3h10v18H7zM10.5 18.5h3',
        queue: 'M4 6h16M4 12h10M4 18h7M18 15l2 2-2 2'
      };
      const navGroups = [
        { key: 'dashboard', label: 'Dashboard', groupIcon: 'overview', items: [
          { href: '/admin', label: 'Overview', icon: 'overview', badge: 'newBookings', badgeTitle: 'Booking baru' }
        ] },
        { key: 'konten', label: 'Konten Website', groupIcon: 'palette', items: [
          { href: '/admin/content', label: 'Teks Website', icon: 'content' },
          { href: '/admin/brand', label: 'Identitas Brand', icon: 'palette' },
          { href: '/admin/appearance', label: 'Warna & Font', icon: 'type' },
          { href: '/admin/sections', label: 'Urutan Section', icon: 'layers' },
          { href: '/admin/hero', label: 'Hero Slideshow', icon: 'image' },
          { href: '/admin/home-stats', label: 'Statistik Homepage', icon: 'plus' },
          { href: '/admin/tnc', label: 'Syarat & Ketentuan', icon: 'doc' },
          { href: '/admin/pages', label: 'Halaman & Navigasi', icon: 'home' }
        ] },
        { key: 'katalog', label: 'Katalog & Harga', groupIcon: 'tag', items: [
          { href: '/admin/cities', label: 'Kota', icon: 'pin' },
          { href: '/admin/categories', label: 'Kategori Paket', icon: 'tag' },
          { href: '/admin/packages', label: 'Paket', icon: 'box' },
          { href: '/admin/durations', label: 'Harga & Foto Edit', icon: 'wallet' },
          { href: '/admin/addons', label: 'Add-on', icon: 'plus' },
          { href: '/admin/extra-time', label: 'Extra Time', icon: 'clock' }
        ] },
        { key: 'operasional', label: 'Operasional', groupIcon: 'calendar', items: [
          { href: '/admin/bookings', label: 'Kelola Booking', icon: 'calendar', badge: 'bookings' },
          { href: '/admin/selection', label: 'Seleksi Foto', icon: 'select', badge: 'selectionSubmitted' },
          { href: '/admin/selection/settings', label: 'Pengaturan Seleksi', icon: 'gear' },
          { href: '/admin/editing', label: 'Antrean Editing', icon: 'queue', badge: 'editing' },
          { href: '/admin/upgrades', label: 'Upgrade Paket', icon: 'plus' },
          { href: '/admin/availability', label: 'Jadwal Tersedia', icon: 'clock' },
          { href: '/admin/team', label: 'Tim yang Bertugas', icon: 'users' },
          { href: '/admin/portfolio', label: 'Portfolio', icon: 'image' },
          { href: '/admin/portfolio-categories', label: 'Kategori Gallery', icon: 'select' }
        ] },
        { key: 'komunikasi', label: 'Komunikasi', groupIcon: 'google', items: [
          { href: '/admin/google', label: 'Google Calendar', icon: 'google', dot: true },
          { href: '/admin/google#drive', label: 'Google Drive', icon: 'drive' },
          { href: '/admin/articles', label: 'Artikel', icon: 'doc' },
          { href: '/admin/faqs', label: 'FAQ', icon: 'help' },
          { href: '/admin/testimonials', label: 'Testimoni', icon: 'star' },
          { href: '/admin/testimonial-link', label: 'Link Testimoni', icon: 'link' },
          { href: '/admin/notifications', label: 'Notifikasi', icon: 'bell', badge: 'notifications' },
          { href: '/admin/push', label: 'Notifikasi HP', icon: 'phone' }
        ] },
        { key: 'pengaturan', label: 'Pengaturan', groupIcon: 'gear', items: [
          { href: '/admin/wa-template', label: 'Template Chat', icon: 'link' },
          { href: '/admin/payment', label: 'Pembayaran (DP)', icon: 'wallet' },
          { href: '/admin/settings', label: 'Kontak & Password', icon: 'gear' }
        ] }
      ];
      const badges = typeof navBadges !== 'undefined' && navBadges ? navBadges : { bookings: 0, newBookings: 0, selectionSubmitted: 0, editing: 0, notifications: 0 };
      const pathOf = (href) => href.split('#')[0];
      const isActive = (href) => {
        const p = pathOf(href);
        if (p === '/admin') return currentPath === '/admin';
        // The selection settings page must not light up the "Seleksi Foto" menu too.
        if (p === '/admin/selection') return currentPath === '/admin/selection' || /^\/admin\/selection\/\d+/.test(currentPath);
        return currentPath === p || currentPath.indexOf(p + '/') === 0;
      };
      const groupHasActive = (g) => g.items.some((it) => it.href && isActive(it.href));
    %>

    <nav class="admin-nav" data-admin-nav>
      <% navGroups.forEach(function (g) { %>
        <div class="nav-group <%= groupHasActive(g) ? 'is-open' : '' %>" data-nav-group="<%= g.key %>">
          <button type="button" class="nav-group__head" data-nav-toggle-group
                  aria-expanded="<%= groupHasActive(g) ? 'true' : 'false' %>">
            <svg class="nav-group__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="<%= ICON[g.groupIcon] || ICON.box %>"/>
            </svg>
            <span class="nav-group__label"><%= g.label %></span>
            <svg class="nav-group__chev" viewBox="0 0 24 24" width="14" height="14" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 6l6 6-6 6"/>
            </svg>
          </button>
          <div class="nav-group__body">
            <%# Satu wrapper: animasi grid-template-rows hanya bisa meringkas SATU baris.
                Dengan banyak anak langsung, baris sisanya tetap setinggi penuh dan
                meninggalkan celah kosong saat grup ditutup. %>
            <div class="nav-group__inner">
            <% g.items.forEach(function (item) { %>
              <% if (item.soon) { %>
                <span class="admin-nav__item is-soon" title="Disiapkan untuk <%= item.soon %>">
                  <svg class="admin-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                       stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="<%= ICON[item.icon] || ICON.box %>"/>
                  </svg>
                  <span class="admin-nav__label"><%= item.label %></span>
                  <span class="nav-soon"><%= item.soon %></span>
                </span>
              <% } else { %>
                <a href="<%= base %><%= item.href %>" title="<%= item.label %>"
                   class="admin-nav__item <%= isActive(item.href) ? 'is-active' : '' %>">
                  <svg class="admin-nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                       stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="<%= ICON[item.icon] || ICON.box %>"/>
                  </svg>
                  <span class="admin-nav__label"><%= item.label %></span>
                  <% if (item.dot && typeof gcalReady !== 'undefined' && gcalReady) { %><span class="nav-dot" title="Terhubung"></span><% } %>
                  <% if (item.badge && badges[item.badge]) { %>
                    <span class="nav-badge" title="<%= item.badgeTitle || '' %>"><%= badges[item.badge] %></span>
                  <% } %>
                </a>
              <% } %>
            <% }); %>
            </div>
          </div>
        </div>
      <% }); %>
    </nav>

    <div class="admin-side__foot">
      <button type="button" class="admin-collapse" data-side-collapse aria-label="Ciutkan sidebar">
        <span data-collapse-icon>&#8249;&#8249;</span>
      </button>
      <a href="<%= base %>/" target="_blank" rel="noopener">Lihat website &#8599;</a>
      <form method="post" action="<%= base %>/admin/logout">
        <button type="submit" class="admin-logout">Keluar</button>
      </form>
    </div>
  </aside>

  <div class="admin-main">
    <header class="admin-topbar">
      <button class="admin-burger" type="button" aria-label="Menu" data-side-toggle>
        <span></span><span></span><span></span>
      </button>
      <div class="admin-topbar__title">
        <span class="admin-topbar__eyebrow">Dashboard</span>
        <h1><%= pageTitle %></h1>
      </div>

      <a class="admin-bell" href="<%= base %>/admin/notifications"
         title="Notifikasi" aria-label="Notifikasi<%= badges.notifications ? ' (' + badges.notifications + ' belum dibaca)' : '' %>">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 4a6 6 0 0 0-6 6v4l-2 3h16l-2-3v-4a6 6 0 0 0-6-6zM10 20a2 2 0 0 0 4 0"/>
        </svg>
        <% if (badges.notifications) { %><span class="admin-bell__badge"><%= badges.notifications > 99 ? '99+' : badges.notifications %></span><% } %>
      </a>

      <div class="publish-bar">
        <% if (pending && pending.total > 0) { %>
          <span class="publish-bar__state publish-bar__state--draft">
            <%= pending.total %> perubahan belum dipublikasi
          </span>
        <% } else { %>
          <span class="publish-bar__state">Semua perubahan sudah live</span>
        <% } %>
        <a class="admin-btn admin-btn--ghost" href="<%= base %>/admin/preview?path=<%= encodeURIComponent(currentPath.replace(/^\/admin.*/, '/')) %>" target="_blank" rel="noopener">Preview</a>
        <form method="post" action="<%= base %>/admin/publish" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="admin-btn admin-btn--primary" type="submit" <%= pending && pending.total > 0 ? '' : 'disabled' %>>Publish Changes</button>
        </form>
        <form method="post" action="<%= base %>/admin/cancel" class="inline-form" data-confirm="Batalkan semua perubahan draft dan kembalikan ke versi terpublikasi?">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="admin-btn admin-btn--ghost" type="submit" <%= pending && pending.total > 0 ? '' : 'disabled' %>>Cancel Changes</button>
        </form>
      </div>
    </header>

    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="admin-flash admin-flash--ok"><%= flash %></div>
    <% } %>
    <% if (typeof flashError !== 'undefined' && flashError) { %>
      <div class="admin-flash admin-flash--err"><%= flashError %></div>
    <% } %>
    <% if (typeof extraFlash !== 'undefined' && extraFlash) { %>
      <div class="admin-flash admin-flash--ok"><%= extraFlash %></div>
    <% } %>

    <div class="admin-content">
      <%- body %>
    </div>
  </div>
  <div class="admin-toast" data-toast role="status" aria-live="polite"></div>
  <script src="<%= base %>/assets/admin.js?v=<%= assetVersion.admin %>" defer></script>
</body>
</html>
