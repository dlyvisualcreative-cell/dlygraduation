<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %> — Admin <%= brand.name %></title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="<%= favicon.src %>" type="image/png">
  <link rel="alternate icon" href="<%= favicon.fallback %>" type="image/svg+xml">
  <link rel="apple-touch-icon" href="<%= favicon.src %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <%# v16 — Montserrat juga di halaman tanpa sidebar (login), supaya seragam. %>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%= base %>/assets/admin.css?v=<%= assetVersion.admin %>">
</head>
<body class="admin-body admin-body--blank">
  <%- body %>
</body>
</html>
