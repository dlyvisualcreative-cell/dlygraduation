<div class="admin-note">
  Perubahan di halaman ini disimpan sebagai <strong>draft</strong>. Website publik hanya berubah setelah Anda menekan <strong>Publish Changes</strong>.
  Gunakan <strong>Preview</strong> untuk melihat hasilnya lebih dulu.
</div>

<form method="post" action="<%= base %>/admin/content" class="admin-form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">

  <% groups.forEach(function (group) { %>
    <section class="admin-panel">
      <div class="admin-panel__head">
        <h2><%= group.name %></h2>
        <span class="admin-badge admin-badge--muted"><%= group.fields.length %> kolom</span>
      </div>

      <div class="admin-field-grid">
        <% group.fields.forEach(function (f) { %>
          <div class="admin-field <%= (f.type === 'textarea') ? 'admin-field--full' : '' %>">
            <label for="<%= f.key %>">
              <%= f.label %>
              <% if (String(f.value) !== String(f.liveValue)) { %><span class="admin-badge admin-badge--warn">draft berubah</span><% } %>
            </label>

            <% if (f.type === 'textarea') { %>
              <textarea id="<%= f.key %>" name="<%= f.key %>" rows="3"><%= f.value %></textarea>
            <% } else if (f.type === 'bool') { %>
              <label class="admin-check">
                <input type="checkbox" name="<%= f.key %>" value="1" <%= f.value === '1' ? 'checked' : '' %>>
                <span>Aktif</span>
              </label>
            <% } else if (f.type === 'number') { %>
              <input type="number" id="<%= f.key %>" name="<%= f.key %>" value="<%= f.value %>">
            <% } else if (f.type === 'color') { %>
              <input type="color" id="<%= f.key %>" name="<%= f.key %>" value="<%= f.value %>">
            <% } else { %>
              <input type="text" id="<%= f.key %>" name="<%= f.key %>" value="<%= f.value %>">
            <% } %>

            <% if (String(f.value) !== String(f.liveValue)) { %>
              <span class="admin-hint">Nilai live saat ini: <em><%= f.liveValue %></em></span>
            <% } %>
          </div>
        <% }); %>
      </div>
    </section>
  <% }); %>

  <div class="admin-sticky-actions">
    <button class="admin-btn admin-btn--primary" type="submit">Save Draft</button>
    <a class="admin-btn" href="<%= base %>/admin/preview?path=%2F" target="_blank" rel="noopener">Preview Website</a>
  </div>
</form>
